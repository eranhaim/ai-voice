# Telegram bot token (required) — get from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ElevenLabs (required) — get free key at https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=XB0fDUnXU5powFXDhCwa
ELEVENLABS_MODEL=eleven_v3

# MongoDB Atlas (required)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/voice_bot
MONGO_DB=voice_bot

# OpenAI (required for voice transcription)
OPENAI_API_KEY=your_openai_api_key_here

# PlayAI (TTS) — Israeli TTS; get keys at https://play.ai/api/keys
PLAYAI_API_KEY=your_playai_api_key_here
PLAYAI_USER_ID=your_playai_user_id_here
PLAYAI_TTS_MODEL=PlayDialog
PLAYAI_DEFAULT_VOICE_ID=s3://voice-cloning-zero-shot/.../manifest.json

# Admin dashboard password
ADMIN_PASSWORD=changeme
ADMIN_TELEGRAM_ID=your_telegram_id

# AWS S3 (for voice sample storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your_bucket_name
AWS_REGION=us-east-1
