# Telegram bot token (required) — get from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ElevenLabs (required) — get free key at https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=XB0fDUnXU5powFXDhCwa
ELEVENLABS_MODEL=eleven_v3

# MongoDB Atlas (required)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/voice_bot
MONGO_DB=voice_bot

# OpenAI (required for voice transcription)
OPENAI_API_KEY=your_openai_api_key_here

# Admin dashboard password
ADMIN_PASSWORD=changeme
ADMIN_TELEGRAM_ID=your_telegram_id

# AWS S3 (for voice sample storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your_bucket_name
AWS_REGION=us-east-1

# Modal (Premium / RVC mode) — optional but required for Premium mode.
# Generate with `modal token new` and copy the values from ~/.modal.toml.
MODAL_TOKEN_ID=your_modal_token_id
MODAL_TOKEN_SECRET=your_modal_token_secret

# Optional: neutral ElevenLabs voice used as the source for Premium TTS.
# RVC fully replaces the timbre; the source only needs clean prosody.
RVC_SOURCE_VOICE_ID=iBGtO8PxvJtBWB3yLkrH
